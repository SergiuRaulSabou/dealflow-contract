BEGIN;

-- =========================================================================
-- S005 — Seed Patch: Division Naming Alignment + Missing Role Instances
--
-- Fixes:
--   1. Role instance naming: WC Broking → CT Broking where the client
--      org structure uses CT (role_instance_id keys stay unchanged for
--      FK stability; only display/division fields are corrected)
--   2. Identity default_org_unit_key: WC Broking → CT Broking,
--      WC Auction → CT Auction
--   3. Missing Coastal Auction Ops Managers (CT, DBN, PE)
--   4. Deal maker escalation chains for CT/DBN/PE Auction
--   5. Re-run role alias grants for DIVISION_HEAD/BROKER/OPS to catch
--      all users (idempotent)
--
-- All inserts use ON CONFLICT for idempotency.
-- =========================================================================

-- =========================================================================
-- SECTION 1 — Division naming: WC → CT for Broking and Auction
-- =========================================================================
-- The client org uses "CT Broking" and "CT Auction", not "WC Broking"/"WC Auction".
-- Role instance IDs contain "WC" in the key — we keep the keys stable (FK refs)
-- but fix the org_unit_key, region, and instance_name fields.

-- Broking role instances
UPDATE config.role_instance
SET org_unit_key = 'CT Broking',
    region = 'CT'
WHERE role_instance_id IN (
    '10002_Managing_Director_WC_Broking',
    '10003_Division_Head_WC_Broking',
    '10102_Operations_WC_Broking',
    '10103_Operations_WC_Broking',
    '10104_Operations_WC_Broking'
);

-- CT Broking Deal Makers (keys contain WC)
UPDATE config.role_instance
SET org_unit_key = 'CT Broking',
    region = 'CT'
WHERE role_instance_id LIKE '%_Deal_Maker_WC_Broking';

-- Auction role instances: WC Auction → CT Auction
UPDATE config.role_instance
SET org_unit_key = 'CT Auction',
    region = 'CT'
WHERE role_instance_id LIKE '%_Deal_Maker_WC_Auction';

-- KZN Auction → DBN Auction (client uses DBN for Durban)
UPDATE config.role_instance
SET org_unit_key = 'DBN Auction',
    region = 'DBN'
WHERE role_instance_id LIKE '%_Deal_Maker_KZN_Auction';

-- EC Auction → PE Auction (client uses PE for Port Elizabeth)
UPDATE config.role_instance
SET org_unit_key = 'PE Auction',
    region = 'PE'
WHERE role_instance_id LIKE '%_Deal_Maker_EC_Auction';

-- Identity default_org_unit_key alignment
UPDATE security.identity SET default_org_unit_key = 'CT Broking' WHERE default_org_unit_key = 'WC Broking';
UPDATE security.identity SET default_org_unit_key = 'CT Auction' WHERE default_org_unit_key = 'WC Auction';
UPDATE security.identity SET default_org_unit_key = 'DBN Auction' WHERE default_org_unit_key = 'KZN Auction';
UPDATE security.identity SET default_org_unit_key = 'PE Auction' WHERE default_org_unit_key = 'EC Auction';

-- Coastal Auction managing director: update org_unit_key
UPDATE config.role_instance
SET org_unit_key = 'Coastal Auction'
WHERE role_instance_id = '20002_Managing_Director_Coastal_Auction';

-- =========================================================================
-- SECTION 2 — Missing Coastal Auction Ops Managers
-- =========================================================================
-- The client CSV shows CT/DBN/PE Auction deal makers escalating to
-- operations roles that don't exist. We create them under the
-- Coastal Auction managing director.

INSERT INTO config.role_instance (
    role_instance_id, role_key, instance_name, division_key, org_unit_key,
    country, region, area, escalates_to_role_instance_id,
    is_active, effective_from
)
VALUES
    -- CT Auction Ops (3 slots, matching JHB Auction pattern)
    ('20201_Operations_CT_Auction', 'OPS_MANAGER', 'Operations_CT_Auction',
     'Auction', 'CT Auction', 'SA', 'CT', 'National',
     '20002_Managing_Director_Coastal_Auction', TRUE, '2026-03-01'),
    ('20202_Operations_CT_Auction', 'OPS_MANAGER', 'Operations_CT_Auction',
     'Auction', 'CT Auction', 'SA', 'CT', 'National',
     '20002_Managing_Director_Coastal_Auction', TRUE, '2026-03-01'),

    -- DBN Auction Ops (1 slot — smaller team)
    ('20301_Operations_DBN_Auction', 'OPS_MANAGER', 'Operations_DBN_Auction',
     'Auction', 'DBN Auction', 'SA', 'DBN', 'National',
     '20002_Managing_Director_Coastal_Auction', TRUE, '2026-03-01'),

    -- PE Auction Ops (1 slot — smallest team)
    ('20401_Operations_PE_Auction', 'OPS_MANAGER', 'Operations_PE_Auction',
     'Auction', 'PE Auction', 'SA', 'PE', 'National',
     '20002_Managing_Director_Coastal_Auction', TRUE, '2026-03-01')
ON CONFLICT (role_instance_id) DO UPDATE
SET role_key                      = EXCLUDED.role_key,
    instance_name                 = EXCLUDED.instance_name,
    division_key                  = EXCLUDED.division_key,
    org_unit_key                  = EXCLUDED.org_unit_key,
    country                       = EXCLUDED.country,
    region                        = EXCLUDED.region,
    area                          = EXCLUDED.area,
    escalates_to_role_instance_id = EXCLUDED.escalates_to_role_instance_id,
    is_active                     = EXCLUDED.is_active,
    effective_from                = EXCLUDED.effective_from;

-- =========================================================================
-- SECTION 3 — Fix deal maker escalation chains
-- =========================================================================
-- CT Auction deal makers → Operations_CT_Auction
UPDATE config.role_instance
SET escalates_to_role_instance_id = '20201_Operations_CT_Auction'
WHERE role_instance_id LIKE '%_Deal_Maker_WC_Auction'
  OR role_instance_id LIKE '%_Deal_Maker_CT_Auction';

-- DBN Auction deal makers → Operations_DBN_Auction
UPDATE config.role_instance
SET escalates_to_role_instance_id = '20301_Operations_DBN_Auction'
WHERE role_instance_id LIKE '%_Deal_Maker_KZN_Auction'
  OR role_instance_id LIKE '%_Deal_Maker_DBN_Auction';

-- PE Auction deal makers → Operations_PE_Auction
UPDATE config.role_instance
SET escalates_to_role_instance_id = '20401_Operations_PE_Auction'
WHERE role_instance_id LIKE '%_Deal_Maker_EC_Auction'
  OR role_instance_id LIKE '%_Deal_Maker_PE_Auction';

-- =========================================================================
-- SECTION 4 — Broker division map alignment
-- =========================================================================
-- Update any existing broker_division_map entries that use old naming.
UPDATE security.broker_division_map SET division_key = 'CT Broking' WHERE division_key = 'WC Broking';
UPDATE security.broker_division_map SET division_key = 'CT Auction' WHERE division_key = 'WC Auction';
UPDATE security.broker_division_map SET division_key = 'DBN Auction' WHERE division_key = 'KZN Auction';
UPDATE security.broker_division_map SET division_key = 'PE Auction' WHERE division_key = 'EC Auction';

-- =========================================================================
-- SECTION 5 — Re-run role alias grants (idempotent)
-- =========================================================================
-- Ensures every DIV_APPROVER also has DIVISION_HEAD, every DEAL_MAKER
-- also has BROKER, every OPS_MANAGER also has OPS.
-- This catches users loaded by S004 that V010's initial run may have missed
-- if S004 ran after V010.

INSERT INTO security.role_assignment (identity_id, role_key, assigned_at)
SELECT ra.identity_id, 'DIVISION_HEAD', NOW()
FROM security.role_assignment ra
WHERE ra.role_key = 'DIV_APPROVER'
  AND NOT EXISTS (
      SELECT 1 FROM security.role_assignment ra2
      WHERE ra2.identity_id = ra.identity_id AND ra2.role_key = 'DIVISION_HEAD'
  );

INSERT INTO security.role_assignment (identity_id, role_key, assigned_at)
SELECT ra.identity_id, 'BROKER', NOW()
FROM security.role_assignment ra
WHERE ra.role_key = 'DEAL_MAKER'
  AND NOT EXISTS (
      SELECT 1 FROM security.role_assignment ra2
      WHERE ra2.identity_id = ra.identity_id AND ra2.role_key = 'BROKER'
  );

INSERT INTO security.role_assignment (identity_id, role_key, assigned_at)
SELECT ra.identity_id, 'OPS', NOW()
FROM security.role_assignment ra
WHERE ra.role_key = 'OPS_MANAGER'
  AND NOT EXISTS (
      SELECT 1 FROM security.role_assignment ra2
      WHERE ra2.identity_id = ra.identity_id AND ra2.role_key = 'OPS'
  );

-- =========================================================================
-- SECTION 6 — Division reference data for UI dropdowns
-- =========================================================================
-- Populate config.org_unit with the canonical division list for Retool selectors.
INSERT INTO config.org_unit (org_unit_key, display_name, created_at)
VALUES
    ('JHB Broking',     'JHB Broking',     NOW()),
    ('CT Broking',      'CT Broking',      NOW()),
    ('JHB Auction',     'JHB Auction',     NOW()),
    ('CT Auction',      'CT Auction',      NOW()),
    ('DBN Auction',     'DBN Auction',     NOW()),
    ('PE Auction',      'PE Auction',      NOW()),
    ('Coastal Auction', 'Coastal Auction', NOW()),
    ('GCS',             'GCS',             NOW()),
    ('Finance',         'Finance',         NOW()),
    ('Executive',       'Executive',       NOW())
ON CONFLICT (org_unit_key) DO UPDATE
SET display_name = EXCLUDED.display_name;

-- Set parent relationships (divisions under their stream)
-- First ensure parent org units exist
INSERT INTO config.org_unit (org_unit_key, display_name) VALUES ('Broking', 'Broking') ON CONFLICT DO NOTHING;
INSERT INTO config.org_unit (org_unit_key, display_name) VALUES ('Auction', 'Auction') ON CONFLICT DO NOTHING;

UPDATE config.org_unit SET parent_org_unit_id = (SELECT org_unit_id FROM config.org_unit WHERE org_unit_key = 'Broking')
WHERE org_unit_key IN ('JHB Broking', 'CT Broking');

UPDATE config.org_unit SET parent_org_unit_id = (SELECT org_unit_id FROM config.org_unit WHERE org_unit_key = 'Auction')
WHERE org_unit_key IN ('JHB Auction', 'CT Auction', 'DBN Auction', 'PE Auction', 'Coastal Auction');

COMMIT;
