-- Delete party
CREATE OR REPLACE FUNCTION api.ops_delete_draft_party(p_draft_party_id BIGINT)
RETURNS VOID LANGUAGE plpgsql AS $$
BEGIN
    DELETE FROM ops.deal_draft_party WHERE draft_party_id = p_draft_party_id;
    IF NOT FOUND THEN RAISE EXCEPTION 'draft_party_id % not found', p_draft_party_id; END IF;
END;
$$;

-- Update party (partial update, preserves NULLs as "no change")
CREATE OR REPLACE FUNCTION api.ops_update_draft_party(
    p_draft_party_id BIGINT,
    p_party_name TEXT DEFAULT NULL,
    p_legal_name TEXT DEFAULT NULL,
    p_trading_name TEXT DEFAULT NULL,
    p_registration_number TEXT DEFAULT NULL,
    p_vat_number TEXT DEFAULT NULL,
    p_jse_listed BOOLEAN DEFAULT NULL,
    p_address_line1 TEXT DEFAULT NULL,
    p_address_line2 TEXT DEFAULT NULL,
    p_address_line3 TEXT DEFAULT NULL,
    p_address_line4 TEXT DEFAULT NULL,
    p_contact_name TEXT DEFAULT NULL,
    p_contact_number TEXT DEFAULT NULL,
    p_contact_email TEXT DEFAULT NULL,
    p_party_email TEXT DEFAULT NULL,
    p_party_phone TEXT DEFAULT NULL,
    p_is_primary BOOLEAN DEFAULT NULL,
    p_requires_fica BOOLEAN DEFAULT NULL,
    p_invoicing_instructions TEXT DEFAULT NULL,
    p_lead_source TEXT DEFAULT NULL,
    p_lead_rebase_link TEXT DEFAULT NULL
)
RETURNS VOID LANGUAGE plpgsql AS $$
BEGIN
    UPDATE ops.deal_draft_party SET
        party_name             = COALESCE(p_party_name, party_name),
        legal_name             = COALESCE(p_legal_name, legal_name),
        trading_name           = COALESCE(p_trading_name, trading_name),
        registration_number    = COALESCE(p_registration_number, registration_number),
        vat_number             = COALESCE(p_vat_number, vat_number),
        jse_listed             = COALESCE(p_jse_listed, jse_listed),
        address_line1          = COALESCE(p_address_line1, address_line1),
        address_line2          = COALESCE(p_address_line2, address_line2),
        address_line3          = COALESCE(p_address_line3, address_line3),
        address_line4          = COALESCE(p_address_line4, address_line4),
        contact_name           = COALESCE(p_contact_name, contact_name),
        contact_number         = COALESCE(p_contact_number, contact_number),
        contact_email          = COALESCE(p_contact_email, contact_email),
        party_email            = COALESCE(p_party_email, party_email),
        party_phone            = COALESCE(p_party_phone, party_phone),
        is_primary             = COALESCE(p_is_primary, is_primary),
        requires_fica          = COALESCE(p_requires_fica, requires_fica),
        invoicing_instructions = COALESCE(p_invoicing_instructions, invoicing_instructions),
        lead_source            = COALESCE(p_lead_source, lead_source),
        lead_rebase_link       = COALESCE(p_lead_rebase_link, lead_rebase_link)
    WHERE draft_party_id = p_draft_party_id;
    IF NOT FOUND THEN RAISE EXCEPTION 'draft_party_id % not found', p_draft_party_id; END IF;
END;
$$;

