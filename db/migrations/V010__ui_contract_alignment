-- -------------------------------------------------------------------------
-- 0. Idempotent role guards
-- -------------------------------------------------------------------------
DO $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'app_ops') THEN CREATE ROLE app_ops NOLOGIN; END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'app_finance') THEN CREATE ROLE app_finance NOLOGIN; END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'app_broker') THEN CREATE ROLE app_broker NOLOGIN; END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'app_ui') THEN CREATE ROLE app_ui NOLOGIN; END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'app_system') THEN CREATE ROLE app_system NOLOGIN; END IF;
END;
$$;

-- =========================================================================
-- SECTION 1 — Role key reconciliation
-- =========================================================================
-- The approval engine (V004/V005/V007) hardcodes DIVISION_HEAD, BROKER, OPS.
-- The org workbook (S004) uses DIV_APPROVER, DEAL_MAKER, OPS_MANAGER.
-- Strategy: keep both in role_catalog; dual-assign users so approval
-- rules and RLS work without modifying the hardcoded functions.

INSERT INTO config.role_catalog (role_key, role_name, role_type, role_scope)
VALUES
    ('DIVISION_HEAD', 'Divisional Head (Approval Alias)', 'APPROVAL', 'Gate 2 approval engine'),
    ('BROKER',        'Broker (Approval Alias)',          'PARTICIPANT', 'Deal participation and RLS'),
    ('OPS',           'Operations (Task Alias)',           'APPLICATION', 'Task list visibility')
ON CONFLICT (role_key) DO UPDATE
SET role_scope = EXCLUDED.role_scope;

-- Grant DIVISION_HEAD alias to all users who have DIV_APPROVER
INSERT INTO security.role_assignment (identity_id, role_key, assigned_at)
SELECT ra.identity_id, 'DIVISION_HEAD', NOW()
FROM security.role_assignment ra
WHERE ra.role_key = 'DIV_APPROVER'
  AND NOT EXISTS (
      SELECT 1 FROM security.role_assignment ra2
      WHERE ra2.identity_id = ra.identity_id AND ra2.role_key = 'DIVISION_HEAD'
  );

-- Grant BROKER alias to all users who have DEAL_MAKER
INSERT INTO security.role_assignment (identity_id, role_key, assigned_at)
SELECT ra.identity_id, 'BROKER', NOW()
FROM security.role_assignment ra
WHERE ra.role_key = 'DEAL_MAKER'
  AND NOT EXISTS (
      SELECT 1 FROM security.role_assignment ra2
      WHERE ra2.identity_id = ra.identity_id AND ra2.role_key = 'BROKER'
  );

-- Grant OPS alias to all users who have OPS_MANAGER
INSERT INTO security.role_assignment (identity_id, role_key, assigned_at)
SELECT ra.identity_id, 'OPS', NOW()
FROM security.role_assignment ra
WHERE ra.role_key = 'OPS_MANAGER'
  AND NOT EXISTS (
      SELECT 1 FROM security.role_assignment ra2
      WHERE ra2.identity_id = ra.identity_id AND ra2.role_key = 'OPS'
  );

