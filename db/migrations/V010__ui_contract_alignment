-- Milestone upsert
CREATE OR REPLACE FUNCTION api.ops_upsert_draft_milestone(
    p_draft_id BIGINT,
    p_milestone_key TEXT,
    p_milestone_date DATE DEFAULT NULL,
    p_milestone_note TEXT DEFAULT NULL
)
RETURNS BIGINT LANGUAGE plpgsql AS $$
DECLARE v_id BIGINT;
BEGIN
    INSERT INTO ops.deal_draft_milestone (draft_id, milestone_key, milestone_date, milestone_note)
    VALUES (p_draft_id, p_milestone_key, p_milestone_date, p_milestone_note)
    ON CONFLICT (draft_id, milestone_key) DO UPDATE
    SET milestone_date = COALESCE(EXCLUDED.milestone_date, ops.deal_draft_milestone.milestone_date),
        milestone_note = COALESCE(EXCLUDED.milestone_note, ops.deal_draft_milestone.milestone_note)
    RETURNING draft_milestone_id INTO v_id;
    RETURN v_id;
END;
$$;

-- Updated doc upsert with override fields
CREATE OR REPLACE FUNCTION api.ops_upsert_draft_doc(
    p_draft_id BIGINT,
    p_doc_code TEXT,
    p_is_confirmed BOOLEAN DEFAULT FALSE,
    p_note TEXT DEFAULT NULL,
    p_confirmed_by BIGINT DEFAULT NULL,
    p_is_overridden BOOLEAN DEFAULT FALSE,
    p_override_reason TEXT DEFAULT NULL,
    p_file_reference TEXT DEFAULT NULL
)
RETURNS BIGINT LANGUAGE plpgsql AS $$
DECLARE v_id BIGINT;
BEGIN
    INSERT INTO ops.deal_draft_doc_status (
        draft_id, doc_code, is_confirmed, note, confirmed_by_identity_id, confirmed_at,
        is_overridden, override_reason, file_reference
    )
    VALUES (
        p_draft_id, p_doc_code, p_is_confirmed, p_note, p_confirmed_by,
        CASE WHEN p_is_confirmed THEN NOW() ELSE NULL END,
        p_is_overridden, p_override_reason, p_file_reference
    )
    ON CONFLICT (draft_id, doc_code) DO UPDATE
    SET is_confirmed           = EXCLUDED.is_confirmed,
        note                   = EXCLUDED.note,
        confirmed_by_identity_id = EXCLUDED.confirmed_by_identity_id,
        confirmed_at           = EXCLUDED.confirmed_at,
        is_overridden          = EXCLUDED.is_overridden,
        override_reason        = EXCLUDED.override_reason,
        file_reference         = EXCLUDED.file_reference
    RETURNING draft_doc_status_id INTO v_id;
    RETURN v_id;
END;
$$;

-- Cancel draft
CREATE OR REPLACE FUNCTION api.ops_cancel_draft(
    p_draft_id BIGINT,
    p_cancelled_by BIGINT
)
RETURNS VOID LANGUAGE plpgsql AS $$
BEGIN
    UPDATE ops.deal_draft
    SET draft_status = 'CANCELLED',
        updated_by_identity_id = p_cancelled_by,
        updated_at = NOW()
    WHERE draft_id = p_draft_id
      AND draft_status NOT IN ('SUBMITTED', 'CANCELLED');

    IF NOT FOUND THEN
        RAISE EXCEPTION 'draft_id % not found or not in a cancellable state', p_draft_id;
    END IF;

    INSERT INTO audit.event_log (event_type, gate_key, actor_identity_id, event_payload)
    VALUES ('DRAFT_CANCELLED', 'G0', p_cancelled_by, jsonb_build_object('draft_id', p_draft_id));
END;
$$;

-- Updated create_draft (adds estimated_deadline, division_key to V009's deal_name/deal_family)
CREATE OR REPLACE FUNCTION api.ops_create_draft(
    p_business_key TEXT,
    p_subtype_key TEXT,
    p_created_by BIGINT,
    p_deal_name TEXT DEFAULT NULL,
    p_deal_family TEXT DEFAULT NULL,
    p_division_key TEXT DEFAULT NULL,
    p_estimated_deadline DATE DEFAULT NULL
)
RETURNS BIGINT LANGUAGE plpgsql AS $$
DECLARE v_draft_id BIGINT;
BEGIN
    INSERT INTO ops.deal_draft (
        deal_business_key, deal_subtype_key, deal_name, deal_family,
        division_key, estimated_deadline,
        draft_status, current_gate_key,
        created_by_identity_id, updated_by_identity_id
    )
    VALUES (
        NULLIF(btrim(p_business_key), ''), p_subtype_key, p_deal_name, p_deal_family,
        p_division_key, p_estimated_deadline,
        'DRAFT', 'G0', p_created_by, p_created_by
    )
    RETURNING draft_id INTO v_draft_id;

    INSERT INTO audit.event_log (event_type, gate_key, actor_identity_id, event_payload)
    VALUES ('DRAFT_CREATED', 'G0', p_created_by,
            jsonb_build_object('draft_id', v_draft_id, 'deal_subtype_key', p_subtype_key, 'deal_name', p_deal_name));

    RETURN v_draft_id;
END;
$$;

-- Pipeline summary view
CREATE OR REPLACE VIEW api.v_pipeline_summary AS
WITH draft_stats AS (
    SELECT d.division_key, d.draft_status, d.current_gate_key,
           COUNT(*) AS deal_count, COALESCE(SUM(e.commission_total), 0) AS commission_total
    FROM ops.deal_draft d
    LEFT JOIN ops.deal_draft_economics e ON e.draft_id = d.draft_id
    WHERE d.draft_status NOT IN ('CANCELLED')
    GROUP BY d.division_key, d.draft_status, d.current_gate_key
),
version_stats AS (
    SELECT dv.division_key, dv.lifecycle_status, dv.current_gate_key,
           COUNT(*) AS deal_count, COALESCE(SUM(e.commission_total), 0) AS commission_total
    FROM core.deal_version dv
    LEFT JOIN core.deal_version_economics e ON e.deal_version_id = dv.deal_version_id
    WHERE dv.is_current = TRUE AND dv.lifecycle_status NOT IN ('SUPERSEDED')
    GROUP BY dv.division_key, dv.lifecycle_status, dv.current_gate_key
)
SELECT 'DRAFT' AS source, division_key, draft_status AS status, current_gate_key, deal_count, commission_total FROM draft_stats
UNION ALL
SELECT 'VERSION' AS source, division_key, lifecycle_status AS status, current_gate_key, deal_count, commission_total FROM version_stats;

