-- =========================================================================
DROP TRIGGER IF EXISTS tr_workflow_run_append_only ON audit.workflow_run;

CREATE OR REPLACE FUNCTION audit.prevent_delete_only()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
    IF TG_OP = 'DELETE' THEN
        RAISE EXCEPTION 'audit.% is append-only; DELETE is not allowed', TG_TABLE_NAME;
    END IF;
    RETURN NEW;
END;
$$;

CREATE TRIGGER tr_workflow_run_no_delete
    BEFORE DELETE ON audit.workflow_run
    FOR EACH ROW EXECUTE FUNCTION audit.prevent_delete_only();

